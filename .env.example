POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=

#database connection string for localhost
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# test database (docker compose --profile test up -d --wait test-db); the database name must end in _test
TEST_DATABASE_URL=postgresql://test:test@127.0.0.1:5433/cyber_newsletter_test
